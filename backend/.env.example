DATABASE_URL=postgresql://pilote:pilote@localhost:5433/pilote
ENVIRONMENT=development

# Secret utilisé pour signer les JWT — générer une valeur aléatoire forte en
# production (ex. `python -c "import secrets; print(secrets.token_urlsafe(64))"`).
# Ceci n'est PAS un vrai secret, juste un exemple pour le dev local.
JWT_SECRET_KEY=change-me-dev-only-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Origines autorisées (CORS), séparées par des virgules — ajouter le domaine
# du frontend déployé (ex. https://mon-app.vercel.app) en production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
